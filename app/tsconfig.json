{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@templates/*": ["../docs/data/material/getting-started/templates/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src", "../docs/data/material/getting-started/templates/**/*.ts", "../docs/data/material/getting-started/templates/**/*.tsx"]
}
